{
  "version": "2.0",
  "envId": "REPLACE_WITH_YOUR_ENV_ID",
  "$schema": "https://framework-1258016615.tce.fsphere.cn/schema/latest.json",
  "framework": {
    "name": "ryderesolve",
    "plugins": {
      "container": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "serviceName": "ryderesolve",
          "servicePath": "/",
          "localPath": "./",
          "cpu": 1,
          "mem": 2,
          "minNum": 1,
          "maxNum": 5,
          "port": 8080,
          "envVariables": {
            "PORT": "8080"
          }
        }
      }
    }
  }
}
