# ---------------------------------------------------------------------------
# Tencent Cloud ADP (Agent Development Platform)
# Leave ADP_APP_KEY empty to run the deterministic offline reasoner — the system
# then produces the same structured rulings without any network dependency.
# ---------------------------------------------------------------------------
ADP_APP_KEY=
ADP_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat
ADP_VISITOR_ID_PREFIX=ryderesolve
ADP_TIMEOUT_S=60
ADP_MAX_RETRIES=1

# auto  -> use ADP when a key is present, otherwise the offline reasoner (default)
# adp   -> force ADP (fails fast if the key is missing)
# offline -> force the deterministic reasoner (useful for reproducible demos)
ENGINE_MODE=auto

# ---------------------------------------------------------------------------
# Escalation gate (stretch goal: human-in-the-loop)
# ---------------------------------------------------------------------------
CONFIDENCE_ESCALATION_THRESHOLD=0.65
AUTO_ESCALATE_DISPUTE_TYPES=safety_incident

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
